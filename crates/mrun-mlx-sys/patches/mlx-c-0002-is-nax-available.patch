mlx-c v0.7.0 does not expose mlx::core::metal::is_nax_available() (MLX v0.32.4,
mlx/backend/metal/device.h), which says whether MLX's M5 Neural Accelerator
(`*_nax`) kernels run: compiled in (SDK and deployment target >= 26.2, else
MLX_METAL_NO_NAX) and available at runtime (macOS 26.2, GPU generation >= 17).
Add mlx_metal_is_nax_available; false without the Metal backend. mrun reports
it as part of the numerics class (FR-027). Applied by build.rs with `patch -p1`.

diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -73,6 +73,9 @@
 add_library(mlxc ${mlxc-src})
 
 target_link_libraries(mlxc PRIVATE mlx)
+if(MLX_BUILD_METAL)
+  target_compile_definitions(mlxc PRIVATE MLX_C_METAL)
+endif()
 target_include_directories(mlxc
                            PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}>)
 set_property(TARGET mlxc PROPERTY POSITION_INDEPENDENT_CODE ON)
diff -ruN a/mlx/c/metal.cpp b/mlx/c/metal.cpp
--- a/mlx/c/metal.cpp
+++ b/mlx/c/metal.cpp
@@ -8,6 +8,14 @@
 #include "mlx/c/error.h"
 #include "mlx/c/private/mlx.h"
 
+#ifdef MLX_C_METAL
+// Declared in mlx/backend/metal/device.h, which needs metal-cpp; false when MLX was built
+// without its NAX kernels (MLX_METAL_NO_NAX).
+namespace mlx::core::metal {
+bool is_nax_available();
+} // namespace mlx::core::metal
+#endif
+
 extern "C" int mlx_metal_get_metallib_path(mlx_string* res) {
   try {
     mlx_string_set_(*res, mlx::core::metal::get_metallib_path());
@@ -20,6 +28,19 @@
 extern "C" int mlx_metal_is_available(bool* res) {
   try {
     *res = mlx::core::metal::is_available();
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
+extern "C" int mlx_metal_is_nax_available(bool* res) {
+  try {
+#ifdef MLX_C_METAL
+    *res = mlx::core::metal::is_available() && mlx::core::metal::is_nax_available();
+#else
+    *res = false;
+#endif
   } catch (std::exception& e) {
     mlx_error(e.what());
     return 1;
diff -ruN a/mlx/c/metal.h b/mlx/c/metal.h
--- a/mlx/c/metal.h
+++ b/mlx/c/metal.h
@@ -30,6 +30,7 @@
 
 int mlx_metal_get_metallib_path(mlx_string* res);
 int mlx_metal_is_available(bool* res);
+int mlx_metal_is_nax_available(bool* res);
 int mlx_metal_set_metallib_path(const char* path);
 int mlx_metal_start_capture(const char* path);
 int mlx_metal_stop_capture(void);
