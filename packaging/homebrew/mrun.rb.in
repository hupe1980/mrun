# Generated by scripts/release/formula.sh for mrun @VERSION@; do not edit.
class Mrun < Formula
  desc "Local inference server for coding agents on Apple Silicon"
  homepage "https://github.com/hupe1980/mrun"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  depends_on arch: :arm64
  depends_on macos: :sequoia

  # `on_macos` keeps `brew audit --strict` (FormulaAudit/MacOSOnLinux) quiet; mrun is macOS-only.
  on_macos do
    url "https://github.com/hupe1980/mrun/releases/download/v@VERSION@/mrun-@VERSION@-macos-arm64.tar.gz"
    sha256 "@SHA256_macos@"
  end

  def install
    # A single binary: the engine's GPU kernels are compiled into it.
    bin.install "bin/mrun"
    bash_completion.install "completions/mrun.bash" => "mrun"
    zsh_completion.install "completions/_mrun"
    fish_completion.install "completions/mrun.fish"
  end

  def caveats
    <<~EOS
      Upgrade with `brew upgrade mrun`, then restart a running server:
        mrun stop && mrun serve --detach
      Models are stored in ~/.mrun/models (MRUN_HOME); `mrun pull` imports a model the
      Hugging Face cache already holds instead of downloading it again.
    EOS
  end

  test do
    version_line = shell_output("#{bin}/mrun --version")
    assert_match version.to_s, version_line
    assert_match " nuvec ", version_line
    assert_match "mrun", shell_output("#{bin}/mrun completions bash")
  end
end
