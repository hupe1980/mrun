-use std::{ffi::c_void, ptr};
+use std::{ffi::c_void, ptr, sync::OnceLock};
+
+/// Experimental mrun reservation gate (patch 0001, not upstream): consulted with the exact
+/// byte length before every raw buffer constructor, so a denied reservation allocates nothing.
+pub type AllocationGate = fn(usize) -> Result<(), String>;
+/// Experimental mrun release report: bytes whose last pooled reference was dropped after a
+/// completed command-buffer wait.
+pub type ReleaseReport = fn(usize);
+
+static ALLOCATION_GATE: OnceLock<(AllocationGate, ReleaseReport)> = OnceLock::new();
+
+/// Installs the process-wide gate once; a second installation is refused.
+pub fn install_allocation_gate(
+    gate: AllocationGate,
+    release: ReleaseReport,
+) -> Result<(), MetalKernelError> {
+    ALLOCATION_GATE
+        .set((gate, release))
+        .map_err(|_| MetalKernelError::InvalidInput("allocation gate already installed".into()))
+}
+
+fn admit(length: usize) -> Result<(), MetalKernelError> {
+    match ALLOCATION_GATE.get() {
+        Some((gate, _)) => gate(length).map_err(MetalKernelError::FailedToCreateResource),
+        None => Ok(()),
+    }
+}
+
+/// Reports bytes released by the pool after synchronization.
+pub fn report_released(length: usize) {
+    if let Some((_, release)) = ALLOCATION_GATE.get() {
+        release(length);
+    }
+}
 
